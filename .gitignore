# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/
venv/
.venv/
env/
.env

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
.npm/
.yarn/
dist/
*.lock

# ── Data (large files not suitable for Git) ───────────────────────────────────
data/raw/
*.mp4
*.avi
*.zip
*.h5
*.hdf5

# ── Models (large weight files — use Git LFS or download scripts) ─────────────
models/*.pt
models/*.onnx
models/*.engine
# Keep the README that describes how to obtain weights
!models/README.md

# ── Logs (runtime artifacts — not source) ─────────────────────────────────────
logs/
*.log
*.jsonl

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── IDEs & OS ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Coverage / test artifacts ─────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/